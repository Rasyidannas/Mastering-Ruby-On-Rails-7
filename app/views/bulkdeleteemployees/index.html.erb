<div>
  <h1>Deletion of an Employee using Checkbox Button</h1>
  <br/>

  <% if @employees.present? %>
    <div>
      <%= form_with(url: bulk_delete_bulkdeleteemployees_path, method: :delete) do |f| %>
        <table class="table">
          <thead>
            <tr>
              <th><%= check_box_tag 'select_all', nil, false, id: 'select-all' %></th>
              <th>ID</th>
              <th>First Name</th>
              <th>Last Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Department</th>
              <th>Country</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @employees.each do |employee| %>
              <tr>
                <td><%= check_box_tag "employee_ids[]", employee.id, false %></td>
                <td><%= employee.id %></td>
                <td><%= employee.firstname %></td>
                <td><%= employee.lastname %></td>
                <td><%= employee.phone %></td>
                <td><%= employee.email %></td>
                <td><%= employee.department.name %></td>
                <td><%= employee.country.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <%= f.submit "Delete using Checkbox", class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
